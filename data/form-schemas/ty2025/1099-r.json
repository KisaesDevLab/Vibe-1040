{
  "formType": "1099-R",
  "taxYear": 2025,
  "version": "2025.1",
  "description": "Distributions From Pensions, Annuities, Retirement or Profit-Sharing Plans, IRAs, Insurance Contracts, etc.",
  "checks": ["r_taxable_not_determined", "r_distribution_code_vs_age", "r_taxable_not_exceeding_gross"],
  "fields": [
    { "key": "recipient_tin", "label": "Recipient TIN", "type": "text", "sensitive": "tin" },
    { "key": "payer_name", "label": "Payer name", "type": "text" },
    { "key": "payer_tin", "label": "Payer TIN", "type": "text" },
    { "key": "recipient_name", "label": "Recipient name", "type": "text" },
    { "key": "account_number", "label": "Account number", "type": "text" },
    { "key": "corrected", "label": "CORRECTED", "type": "bool" },
    { "key": "box_1", "label": "Gross distribution", "type": "money", "box": "1" },
    { "key": "box_2a", "label": "Taxable amount", "type": "money", "box": "2a" },
    { "key": "box_2b_not_determined", "label": "Taxable amount not determined", "type": "bool", "box": "2b", "judgmentRequired": true, "judgmentReason": "Taxable amount not determined — the app does not compute it (§9)." },
    { "key": "box_2b_total_distribution", "label": "Total distribution", "type": "bool", "box": "2b" },
    { "key": "box_3", "label": "Capital gain (included in box 2a)", "type": "money", "box": "3" },
    { "key": "box_4", "label": "Federal income tax withheld", "type": "money", "box": "4" },
    { "key": "box_5", "label": "Employee contributions / Designated Roth contributions or insurance premiums", "type": "money", "box": "5" },
    { "key": "box_6", "label": "Net unrealized appreciation in employer's securities", "type": "money", "box": "6" },
    { "key": "box_7_code", "label": "Distribution code(s)", "type": "code", "box": "7" },
    { "key": "box_7_ira_sep_simple", "label": "IRA/SEP/SIMPLE", "type": "bool", "box": "7" },
    { "key": "box_8", "label": "Other", "type": "money", "box": "8" },
    { "key": "box_9a", "label": "Your percentage of total distribution", "type": "text", "box": "9a" },
    { "key": "box_9b", "label": "Total employee contributions", "type": "money", "box": "9b" },
    { "key": "box_10", "label": "Amount allocable to IRR within 5 years", "type": "money", "box": "10" },
    { "key": "box_11", "label": "1st year of desig. Roth contrib.", "type": "year", "box": "11" },
    { "key": "box_12_fatca", "label": "FATCA filing requirement", "type": "bool", "box": "12" },
    { "key": "box_14", "label": "State tax withheld", "type": "money", "box": "14" },
    { "key": "box_15_state", "label": "State", "type": "text", "box": "15" },
    { "key": "box_15_state_id", "label": "State/Payer's state no.", "type": "text", "box": "15" },
    { "key": "box_16", "label": "State distribution", "type": "money", "box": "16" }
  ]
}
