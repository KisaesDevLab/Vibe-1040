{
  "name": "vibe-1040",
  "version": "0.0.1",
  "description": "Staff-facing 1040 source-document worksheet appliance",
  "license": "BUSL-1.1",
  "author": "KisaesDevLab",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types src/db/migrate.ts up",
    "db:rollback": "node --experimental-strip-types src/db/migrate.ts down",
    "db:seed": "node --experimental-strip-types src/db/seed.ts",
    "worker": "node --experimental-strip-types src/queue/worker.ts",
    "retention": "node --experimental-strip-types src/retention/run.ts",
    "check:providers": "node scripts/check-provider-leakage.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.0.4",
    "@kisaes/vibe-ai-client": "^0.2.2",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.38.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "nodemailer": "^9.0.5",
    "otplib": "^12.0.1",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
