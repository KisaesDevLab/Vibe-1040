# Vibe 1040 — configuration surface (P0)
# Copy to .env and fill. Nothing here is a provider credential; this app holds none.

NODE_ENV=development
PORT=8240
LOG_LEVEL=info

# ── Postgres ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://vibe1040:vibe1040@postgres:5432/vibe1040

# ── Redis / BullMQ ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Vibe AI Router ───────────────────────────────────────────────────────────
# Internal docker network address. Never route this through Caddy.
VIBE_AI_ROUTER_URL=http://vibe-ai-router:8220
VIBE_AI_TOKEN=
# Fail closed if the router does not report US-region pinning for our task classes.
# The router has no region concept yet (QUESTIONS.md Q11); until it does, leaving this
# true will refuse to start. A deployment bound to DigitalOcean-hosted models runs with this
# false by RECORDED DECISION (STATE.md decision log 2026-09-02, QUESTIONS.md Q13) — read both
# before setting it. It is not a development shortcut.
ROUTER_REQUIRE_US_REGION=true
# Refuse to start if our task classes are still pinned local_only when we expect cloud.
# See STATE.md: registration always creates local_only; widening is a firm-admin action.
ROUTER_EXPECTED_SENSITIVITY=cloud_deidentified

# ── Secrets ──────────────────────────────────────────────────────────────────
# 32-byte base64. Salts the TIN hash. Rotating this orphans every existing client join key.
TIN_HASH_SALT=
# 32-byte base64. Signs staff session cookies.
SESSION_SECRET=

# ── Blob storage ─────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/blobs
# 32-byte base64. AES-256-GCM at rest for the local driver.
STORAGE_ENCRYPTION_KEY=
# B2 (S3-compatible) — only read when STORAGE_DRIVER=b2
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=
B2_KEY_ID=
B2_APPLICATION_KEY=

# ── Python sidecar ───────────────────────────────────────────────────────────
SIDECAR_CONCURRENCY=2

# ─────────────────────────────────────────────────────────────────────────────
# NOTE: everything below this line is a SEED VALUE only.
#
# Firm-policy settings (rasterization, extraction, reconciliation, retention,
# licensing) now live in the database and are edited under Admin -> Settings, where
# every change is audited and takes effect without a restart. The values here are
# used only until an admin changes them, so an existing deployment keeps behaving
# exactly as this file said.
#
# Email and SMS delivery are configured ONLY in Admin -> Settings. Credentials for
# them are sealed with STORAGE_ENCRYPTION_KEY before storage.
#
# Everything ABOVE this line is infrastructure, key material, or a compliance
# guardrail, and stays here deliberately — see src/settings/registry.ts.
# ─────────────────────────────────────────────────────────────────────────────

# ── Rasterization (P2) ───────────────────────────────────────────────────────
RASTER_DPI_DEFAULT=300
RASTER_DPI_DIGITAL=200
RASTER_DPI_DEGRADED=400
# Resolution ceiling before encoding. Kept as config, not derived per request —
# policy can change which model serves at any time. See PHASES.md P2.
RASTER_MAX_EDGE_PX=2200
RASTER_JPEG_QUALITY=82

# ── Extraction (P8) ──────────────────────────────────────────────────────────
# Multi-pass agreement is the ONLY confidence signal the router surfaces (Q4).
EXTRACT_PASSES=2
EXTRACT_PASSES_ON_DISAGREEMENT=3

# ── Reconciliation (P9) ──────────────────────────────────────────────────────
# Per-document rounding tolerance, in cents. Do not silently widen.
RECONCILE_TOLERANCE_CENTS=100

# ── Retention (P13) ──────────────────────────────────────────────────────────
# Rasterized page images are derived PII and purge earlier than sources.
RETENTION_RASTER_DAYS=90
RETENTION_DOCUMENT_DAYS=2555
RETENTION_DRY_RUN=false

# ── Productization (P14) ─────────────────────────────────────────────────────
LICENSE_REQUIRED=0
LICENSE_SERVER_URL=https://licensing.kisaes.com
